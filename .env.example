# Copy to .env for local development. Never commit real values.

# Required. Fernet key that encrypts journal text, reflections and Mindy chats.
# Production MUST use the SAME key as the data it reads; never generate a new one for existing data.
MINTRACK_ENCRYPTION_KEY=
# Required. Long random string used to sign sessions.
SECRET_KEY=

# Optional locally (defaults to instance/mindtrack.db). Required in production.
# postgres:// and postgresql:// are converted to postgresql+psycopg:// automatically.
DATABASE_URL=

# --- Production / Cloud Run only (see DEPLOYMENT.md) ---
# MINDTRACK_ENV=production        # also auto-detected on Cloud Run
# Alternative to DATABASE_URL for Cloud SQL (no URL-encoding of the password needed):
# INSTANCE_CONNECTION_NAME=project:asia-south1:instance
# DB_NAME=
# DB_USER=
# DB_PASS=
# AUTO_CREATE_TABLES=false        # default: true locally, false in production
